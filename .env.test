# Values for APP_ENV=test: vp test, Playwright, and CI. Nothing here is a
# secret. The database and mail catcher are the local Docker containers from
# scripts/, and the reader values are placeholders -- playwright.config.ts
# overrides them with the local PostgREST, and the CI build only needs them
# to exist.
DATABASE_URL=postgres://pulse:pulse@localhost:54329/pulse
PULSE_SMTP_URL=smtp://localhost:54330
PULSE_SUBSCRIBER_EMAIL=operator@example.com
PULSE_EMAIL_FROM="Platform Pulse <pulse@localhost>"
VITE_SUPABASE_URL=http://localhost:5199
VITE_SUPABASE_ANON_KEY=placeholder
CLOUDFLARE_ACCOUNT_ID=placeholder
CLOUDFLARE_API_TOKEN=placeholder
