# Platform Pulse configuration schema. Committed, and holds no values.
#
# 1Password is the source of truth, and only this machine talks to it: in
# `dev` every secret resolves from the item `web-platform-pulse` in the `dev`
# vault through the desktop app. Nothing remote does. GitHub Actions reads
# GitHub's own secret store, and `vp run secrets:push` (scripts/push-secrets.ts)
# is what copies the values there from 1Password, so there is no service
# account and no 1Password credential outside this laptop.
#
# `test` -- vp test, Playwright, and CI -- never reaches 1Password either:
# .env.test overrides every item with the local Docker services from scripts/
# and placeholders.
#
# `production` means "the process environment supplies every value". The
# deploy and pipeline workflows set it and pass their secrets as plain
# environment variables, which outrank everything in this file, so no op()
# reference below is ever resolved there.
#
# @currentEnv=$APP_ENV
# @defaultRequired=infer @defaultSensitive=inferFromPrefix(VITE_)
# @plugin(@varlock/1password-plugin)
# @initOp(allowAppAuth=forEnv(dev), account=my)
# ---

# @public @type=enum(dev, test, production)
APP_ENV=dev

# --- The pipeline (src/cli) ---
# @type=url
DATABASE_URL=op(op://dev/web-platform-pulse/DATABASE_URL)
# @type=url
PULSE_SMTP_URL=op(op://dev/web-platform-pulse/PULSE_SMTP_URL)
# The reader's public origin. Confirm and unsubscribe links are built on it.
# It appears in every email we send, so it is not a secret: without @public
# it would be inferred sensitive and masked wherever a log printed it.
# @public @type=url
PULSE_PUBLIC_URL=op(op://dev/web-platform-pulse/PULSE_PUBLIC_URL)
# @type=email
PULSE_SUBSCRIBER_EMAIL=op(op://dev/web-platform-pulse/PULSE_SUBSCRIBER_EMAIL)
PULSE_EMAIL_FROM=op(op://dev/web-platform-pulse/PULSE_EMAIL_FROM)
# Issued per run by GitHub Actions; optional locally. Lifts the unauthenticated
# api.github.com rate limit for the Deno and Bun release lookups.
# @optional
GITHUB_TOKEN=

# --- The reader build (src/reader) ---
# Public by design: both compile into the browser bundle. What stops the anon
# key reading a subscriber's address is migration 4, not secrecy.
# @type=url
VITE_SUPABASE_URL=op(op://dev/web-platform-pulse/VITE_SUPABASE_URL)
VITE_SUPABASE_ANON_KEY=op(op://dev/web-platform-pulse/VITE_SUPABASE_ANON_KEY)

# --- Wrangler authentication (deploy.yml) ---
CLOUDFLARE_ACCOUNT_ID=op(op://dev/web-platform-pulse/CLOUDFLARE_ACCOUNT_ID)
CLOUDFLARE_API_TOKEN=op(op://dev/web-platform-pulse/CLOUDFLARE_API_TOKEN)
