# Platform Pulse configuration schema. Committed, and holds no values: every
# secret resolves from the 1Password item `web-platform-pulse` in the `dev`
# vault, through the desktop app in `dev` and a service account token in
# `production` (the GitHub Actions workflows). `test` -- vp test, Playwright,
# and CI -- never reaches 1Password: .env.test overrides every item with the
# local Docker services from scripts/ and placeholders.
#
# @currentEnv=$APP_ENV
# @defaultRequired=infer @defaultSensitive=inferFromPrefix(VITE_)
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_TOKEN, allowAppAuth=forEnv(dev), account=my)
# ---

# @public @type=enum(dev, test, production)
APP_ENV=dev

# 1Password service account token, set by the workflows only. @internal keeps
# it out of the app's environment.
# @type=opServiceAccountToken @sensitive @internal
OP_TOKEN=

# --- The pipeline (src/cli) ---
# @type=url
DATABASE_URL=op(op://dev/web-platform-pulse/DATABASE_URL)
# @type=url
PULSE_SMTP_URL=op(op://dev/web-platform-pulse/PULSE_SMTP_URL)
# @type=email
PULSE_SUBSCRIBER_EMAIL=op(op://dev/web-platform-pulse/PULSE_SUBSCRIBER_EMAIL)
PULSE_EMAIL_FROM=op(op://dev/web-platform-pulse/PULSE_EMAIL_FROM)
# Issued per run by GitHub Actions; optional locally. Lifts the unauthenticated
# api.github.com rate limit for the Deno and Bun release lookups.
# @optional
GITHUB_TOKEN=

# --- The reader build (src/reader) ---
# Public by design: both compile into the browser bundle. What stops the anon
# key reading a subscriber's address is migration 4, not secrecy.
# @type=url
VITE_SUPABASE_URL=op(op://dev/web-platform-pulse/VITE_SUPABASE_URL)
VITE_SUPABASE_ANON_KEY=op(op://dev/web-platform-pulse/VITE_SUPABASE_ANON_KEY)

# --- Wrangler authentication (deploy.yml) ---
CLOUDFLARE_ACCOUNT_ID=op(op://dev/web-platform-pulse/CLOUDFLARE_ACCOUNT_ID)
CLOUDFLARE_API_TOKEN=op(op://dev/web-platform-pulse/CLOUDFLARE_API_TOKEN)
